# Vault and AWX Specific Sensitive Data
# =====================================

# Vault tokens, certificates, and secrets
*.vault-token
vault-token*
*.pem
*.key
*.crt
*.cert
*.ca-bundle
vault-ca.*
vault-cert.*

# AWX/AAP configuration files that might contain sensitive data
awx-config/
aap-config/
tower-config/
ansible-tower/

# Test files that might contain real credentials
test-credentials/
test-secrets/
*-credentials.json
*-secrets.json
vault-test-*

# Local testing and development files
test_real_vault.py
integration_test.py
local_test_*
dev_*
scratch/
temp/
tmp/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local configuration overrides
local_settings.py
local_config.py
dev_config.py
test_config.py

# Backup files
*.bak
*.backup
*.old

# Log files
*.log
logs/
log/

# Database files (if any testing involves local DBs)
*.db
*.sqlite
*.sqlite3

# Terraform files (if testing with Terraform)
*.tfstate
*.tfstate.*
.terraform/
terraform.tfvars

# Kubernetes files with potential secrets
*-secret.yaml
*-secret.yml
kubeconfig*

# Docker files with potential secrets
docker-compose.override.yml
.dockerignore

# Any files containing actual Vault configuration or real credentials
vault-config.*
real-vault-*
production-*
prod-*

# Files that might be created during plugin testing
plugin-test-results/
test-output/
debug-output/
